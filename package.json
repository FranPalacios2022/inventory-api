{
  "name": "inventory-api",
  "version": "1.0.0",
  "description": "Secure REST API for inventory management: JWT auth, role-based access, stock movements with transactions and CSV stock import.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "express",
    "rest-api",
    "jwt",
    "sequelize",
    "inventory"
  ],
  "author": "Francisco Palacios",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
